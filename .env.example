# ─────────────────────────────────────────────────────────────
# TruthPitch Merch — environment variables
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` to GitHub (it is in .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Database (SQLite) ────────────────────────────────────────
# Relative paths resolve from the /prisma folder.
# Production (Hostinger): use an absolute path outside the app folder, e.g.
#   DATABASE_URL="file:/home/u123456789/truthpitch-data/store.db"
DATABASE_URL="file:./dev.db"

# ── Admin login ──────────────────────────────────────────────
# The single store-owner account for /admin.
ADMIN_EMAIL="owner@truthpitch.com"
ADMIN_PASSWORD="change-me-to-a-long-password"
# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-64-character-hex-string"

# ── Shopify Storefront API (products, cart, checkout) ────────
# Leave these empty to run the store in DEMO MODE with sample products.
# Where to get them:
#   Shopify admin → Settings → Apps and sales channels → install the
#   "Headless" sales channel → Create storefront → copy the PUBLIC access token.
# Store domain is the *.myshopify.com domain (no https://).
SHOPIFY_STORE_DOMAIN=""                 # e.g. truthpitch.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2025-10"

# ── Shopify Admin API (order overview in the admin panel) ────
# Optional. Shopify admin → Settings → Apps and sales channels → Develop apps
# → Create an app → Admin API scopes: read_orders (and read_products) →
# Install → copy the Admin API access token (starts with shpat_).
SHOPIFY_ADMIN_ACCESS_TOKEN=""

# ── Printful ─────────────────────────────────────────────────
# Fulfillment runs through the Printful app installed in Shopify — no key is
# needed for orders to be printed and shipped. Only set this if you want to
# call the Printful API directly (see src/lib/printful.ts).
# Printful dashboard → Settings → API → create a private token.
PRINTFUL_API_KEY=""

# ── Contact form email (required for /contact) ───────────────
# The contact form emails info@truthpitch.com directly; nothing is stored.
# Use the SMTP login of a mailbox, e.g. info@truthpitch.com in Titan Email (via Hostinger):
#   SMTP_HOST=smtp.titan.email, SMTP_PORT=465,
#   SMTP_USER=info@truthpitch.com, SMTP_PASS=that mailbox's password.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Sender address; defaults to SMTP_USER (most hosts require that).
SMTP_FROM=""
# Recipient; defaults to info@truthpitch.com.
CONTACT_TO_EMAIL=""

# ── Uploads ──────────────────────────────────────────────────
# Folder where admin-uploaded images are stored. Defaults to ./uploads.
# Production: use an absolute path outside the app folder.
UPLOAD_DIR=""
