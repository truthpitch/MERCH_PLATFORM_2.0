// Prisma schema — custom content managed from the admin panel.
// Products, prices, cart and checkout live in Shopify; this database only
// stores what Shopify doesn't: homepage content, featured order, product
// stories ("MORE INFO"), uploaded media and the maintenance switch.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Set DATABASE_URL in .env. Relative paths resolve from this /prisma folder.
  // On Hostinger, use an absolute path OUTSIDE the app folder so redeploys
  // don't wipe it, e.g. file:/home/<user>/truthpitch-data/store.db
  url      = env("DATABASE_URL")
}

// Single row (id = 1) holding site-wide settings.
model SiteSettings {
  id                     Int       @id @default(1)
  maintenanceMode        Boolean   @default(false)
  maintenanceMessage     String    @default("We're making a few changes behind the scenes. Please check back shortly.")
  // Ordering pause (admin → Dashboard): the shop stays open, but adding to cart and checkout are off.
  orderingPaused         Boolean   @default(false)
  orderingPauseMessage   String    @default("Ordering is paused for a short while. You can still browse and save your favorites.")
  orderingPausedUntil    DateTime? // optional: ordering opens again by itself at this moment
  // Browser-tab icon uploaded on the Dashboard (/media/favicon-….png), empty = none
  faviconUrl             String    @default("")
  // "Shipping & returns" fold on every product page (admin → Products)
  shippingReturnsText    String    @default("Every item is printed on demand, just for you. Production usually takes 2–5 business days, after which your order ships with a tracking link. Delivery time depends on where you live; you'll see the shipping options and costs at checkout.\n\nBecause each item is made to order, we can't take returns for a wrong size or a change of mind, so please check the size guide before ordering.\n\nDid your order arrive damaged, misprinted or faulty? Contact us within 30 days of delivery with a photo, and we'll send a free replacement or give you a refund.")
  // Legal notice / Impressum (/legal-notice) and refund policy (/refund-policy), edited in admin → Legal
  legalCompanyName       String    @default("TruthPitch")
  legalAddress           String    @default("")
  legalEmail             String    @default("")
  legalPhone             String    @default("")
  legalKvk               String    @default("") // Chamber of Commerce (KvK) number
  legalVat               String    @default("") // VAT (btw) number
  legalExtra             String    @default("") // optional extra text, e.g. legal form or representative
  refundPolicyText       String    @default("") // empty = the default policy in src/lib/legal.ts
  privacyPolicyText      String    @default("") // empty = the default privacy policy in src/lib/privacy-policy.ts
  termsText              String    @default("") // empty = the default terms of service in src/lib/terms.ts
  cookiePolicyText       String    @default("") // empty = the default cookie policy in src/lib/cookie-policy.ts
  howItWorksText         String    @default("") // empty = the default "How it works" page in src/lib/how-it-works.ts
  // Search engine ownership checks (admin → SEO & Traffic), e.g. Google Search Console's code
  googleVerification     String    @default("")
  bingVerification       String    @default("")
  shippingPolicyText     String    @default("") // empty = the default shipping policy in src/lib/shipping-policy.ts
  announcementEnabled    Boolean   @default(false)
  announcementText       String    @default("")
  // Optional countdown and button in the announcement bar
  announcementTimerLabel String    @default("Current offer expires in")
  announcementEndsAt     DateTime?
  announcementCtaLabel   String    @default("")
  announcementCtaUrl     String    @default("")
  heroTitle              String    @default("Merch with a message.")
  heroSubtitle           String    @default("Clean, honest essentials from TruthPitch. Printed on demand, made to last.")
  heroCtaLabel           String    @default("Shop the collection")
  heroImageUrl           String    @default("")
  aboutTitle             String    @default("About TruthPitch")
  contactTitle           String    @default("Contact")
  contactIntro           String    @default("Questions about an order, sizing or anything else? Send us a message and we will get back to you as soon as we can.")
  contactEmail           String    @default("")
  aboutText              String    @default("There is a lot of noise out there: spin, hype and sales talk. In all of that, the truth often gets lost. TruthPitch is a pitch for the truth: clear words, honest ideas and the courage to say them out loud.\n\nThis shop is one way to carry that idea into everyday life. Each piece is a small, visible statement and a conversation starter for the things worth saying.\n\nEvery item is printed on demand when you order it, which means less waste and no warehouses full of unsold stock.")
  // About page (/about)
  aboutIntro             String    @default("TruthPitch started with a simple idea: say what matters, plainly, and stand behind it.")
  aboutImageUrl          String    @default("")
  aboutValue1Title       String    @default("Honest")
  aboutValue1Text        String    @default("No spin and no slogans for the sake of it. Every design starts with something we actually believe.")
  aboutValue2Title       String    @default("Simple")
  aboutValue2Text        String    @default("Black, white and grey. Clean typography. Pieces that let the message do the talking.")
  aboutValue3Title       String    @default("Made to order")
  aboutValue3Text        String    @default("Everything is printed on demand when you order it, so nothing is wasted on stock nobody wants.")
  // About page: mission, vision and the founder's story (empty = section hidden)
  aboutMissionTitle      String    @default("Our Mission")
  aboutMissionText       String    @default("TruthPitch puts honest words on things you wear and use every day, so truth travels wherever you go.\n\nWe turn meaningful words into everyday merch: carefully curated, honestly made, and designed to start real conversations.")
  aboutVisionTitle       String    @default("Our Vision")
  aboutVisionText        String    @default("A world where truth is spoken, worn and shared, and where we see beyond separateness.\n\nWe keep pitching truth, because the world needs it now more than ever.")
  aboutStoryTitle        String    @default("Why I Started TruthPitch")
  aboutStoryText         String    @default("I started TruthPitch because I kept noticing how much noise there is in the world, and how little truth gets through. Headlines, ads and feeds compete for our attention every second, and the real, simple things often get lost along the way.\n\nSome words have the power to wake us up. You are beyond words. Things aren't always black or white. The truth always comes to light. When I read lines like that, something shifts, even if just for a moment. I wanted those moments to last longer than a scroll.\n\nSo I asked myself: what if truth could travel? On a shirt in a crowded street, on a mug at the start of the day, on a sticker on someone's laptop. Small reminders that spark a thought, a question or a real conversation.\n\nTruthPitch is my way of putting truth back into everyday life. Every design is carefully chosen, because I believe the words we carry with us matter.\n\nThank you for being part of it. Wear it, share it, and keep the truth alive.")
  aboutStorySignoff      String    @default("Truth Exists.")
  updatedAt              DateTime  @updatedAt
}

// Products chosen for the homepage, in display order. Keyed by Shopify handle.
model FeaturedProduct {
  id        Int      @id @default(autoincrement())
  handle    String   @unique
  position  Int
  createdAt DateTime @default(now())
}

// The story shown in the "MORE INFO" section of a product page.
model ProductStory {
  handle    String   @id
  story     String   @default("")
  imageUrl  String   @default("")
  // Category chosen in the admin (a slug from src/lib/categories.ts); empty = automatic
  category  String   @default("")
  updatedAt DateTime @updatedAt
}

// Images uploaded through the admin panel (files live in UPLOAD_DIR).
model Media {
  id           Int      @id @default(autoincrement())
  filename     String   @unique // path inside UPLOAD_DIR, e.g. "blog/summer-tee.jpg" (older uploads: no folder)
  name         String   @default("") // display name, e.g. "Summer tee (1)"
  folder       String   @default("general") // MediaFolder slug, only a label: moving keeps the file (and its URL) where it is
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([folder])
}

// Folders on the admin Media tab (e.g. Blog, Products). Images are uploaded into a folder.
model MediaFolder {
  slug      String   @id // "blog"
  name      String // "Blog"
  createdAt DateTime @default(now())
}

// Shop customers (accounts are optional: guests can always check out).
model Customer {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  name           String          @default("")
  passwordHash   String
  createdAt      DateTime        @default(now())
  // Goes up on a password reset, which signs the account out everywhere.
  sessionVersion Int             @default(0)
  // Set once when the emailed activation link is clicked. Until then the account can't sign in.
  activatedAt    DateTime?
  favorites      Favorite[]
  resets         PasswordReset[]
  activations    EmailActivation[]
  reviews        Review[]
}

// A customer's review of a product (one per customer per product; they can edit it).
model Review {
  id         Int      @id @default(autoincrement())
  handle     String   // Shopify product handle
  customerId Int
  rating     Int      // 1–5 stars
  title      String   @default("")
  body       String
  // Only approved reviews are public. New and edited reviews wait for approval in admin → Reviews.
  approved   Boolean  @default(false)
  approvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, handle])
  @@index([handle])
}

// Size table per shop category (e.g. "t-shirts"), edited in admin → Products → Size guides.
// One row per line; cells separated by "|" or a tab; the first line is the header.
model SizeGuide {
  category  String   @id
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

// Activation link sent after registering. Only the token's SHA-256 hash is stored.
model EmailActivation {
  id         Int       @id @default(autoincrement())
  customerId Int
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// Products a signed-in customer saved. Guests keep favorites in a cookie instead.
model Favorite {
  id         Int      @id @default(autoincrement())
  customerId Int
  handle     String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, handle])
}

// "Forgot password" links. Only a hash of the token is stored; links work once, for 1 hour.
model PasswordReset {
  id         Int       @id @default(autoincrement())
  customerId Int
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Blog posts, written in admin → Blog. Content uses simple formatting (## heading, **bold**, - list, [link](url), ![image](url)).
model BlogPost {
  id              Int       @id @default(autoincrement())
  slug            String    @unique // the web address: /blog/<slug>
  title           String
  excerpt         String    @default("") // short summary for the list, search results and link previews
  content         String    @default("")
  coverImageUrl   String    @default("")
  coverImageAlt   String    @default("")
  author          String    @default("TruthPitch")
  tags            String    @default("") // comma-separated
  metaTitle       String    @default("") // optional: overrides the title in Google
  metaDescription String    @default("") // optional: overrides the excerpt in Google
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, publishedAt])
}

// ── Visitor statistics (admin → SEO & Traffic) ─────────────
// Only recorded after a visitor clicks "Accept" in the cookie banner. No IP addresses,
// names or e-mail addresses are stored: just a random visitor id kept in the visitor's own browser.

model AnalyticsSession {
  id          String              @id // random id from the visitor's browser (one visit)
  visitorId   String              // random id that lets us count returning visitors
  startedAt   DateTime            @default(now())
  lastSeenAt  DateTime            @default(now())
  landingPath String              @default("")
  referrer    String              @default("") // the referring website's domain only, e.g. "google.com"
  utmSource   String              @default("")
  utmMedium   String              @default("")
  utmCampaign String              @default("")
  device      String              @default("") // mobile, tablet or desktop
  browser     String              @default("")
  os          String              @default("")
  country     String              @default("") // from the hosting provider's headers, when available
  timeZone    String              @default("") // from the browser, e.g. "Europe/Amsterdam"
  language    String              @default("")
  pageViews   AnalyticsPageView[]

  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([visitorId])
}

model AnalyticsPageView {
  id         Int              @id @default(autoincrement())
  sessionId  String
  path       String
  title      String           @default("")
  enteredAt  DateTime         @default(now())
  durationMs Int              @default(0) // time on the page, sent when the visitor leaves it
  session    AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([enteredAt])
  @@index([sessionId])
  @@index([path])
}

// How many visitors clicked Accept or Reject (no personal data: just the choice and the time).
model ConsentEvent {
  id        Int      @id @default(autoincrement())
  choice    String   // "accepted" or "rejected"
  createdAt DateTime @default(now())

  @@index([createdAt])
}
