// Prisma schema — custom content managed from the admin panel.
// Products, prices, cart and checkout live in Shopify; this database only
// stores what Shopify doesn't: homepage content, featured order, product
// stories ("MORE INFO"), uploaded media and the maintenance switch.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Set DATABASE_URL in .env. Relative paths resolve from this /prisma folder.
  // On Hostinger, use an absolute path OUTSIDE the app folder so redeploys
  // don't wipe it, e.g. file:/home/<user>/truthpitch-data/store.db
  url      = env("DATABASE_URL")
}

// Single row (id = 1) holding site-wide settings.
model SiteSettings {
  id                     Int       @id @default(1)
  maintenanceMode        Boolean   @default(false)
  maintenanceMessage     String    @default("We're making a few changes behind the scenes. Please check back shortly.")
  announcementEnabled    Boolean   @default(false)
  announcementText       String    @default("")
  // Optional countdown and button in the announcement bar
  announcementTimerLabel String    @default("Current offer expires in")
  announcementEndsAt     DateTime?
  announcementCtaLabel   String    @default("")
  announcementCtaUrl     String    @default("")
  heroTitle              String    @default("Merch with a message.")
  heroSubtitle           String    @default("Clean, honest essentials from TruthPitch. Printed on demand, made to last.")
  heroCtaLabel           String    @default("Shop the collection")
  heroImageUrl           String    @default("")
  aboutTitle             String    @default("About TruthPitch")
  contactTitle           String    @default("Contact")
  contactIntro           String    @default("Questions about an order, sizing or anything else? Send us a message and we will get back to you as soon as we can.")
  contactEmail           String    @default("")
  aboutText              String    @default("There is a lot of noise out there: spin, hype and sales talk. In all of that, the truth often gets lost. TruthPitch is a pitch for the truth: clear words, honest ideas and the courage to say them out loud.\n\nThis shop is one way to carry that idea into everyday life. Each piece is a small, visible statement and a conversation starter for the things worth saying.\n\nEvery item is printed on demand when you order it, which means less waste and no warehouses full of unsold stock.")
  // About page (/about)
  aboutIntro             String    @default("TruthPitch started with a simple idea: say what matters, plainly, and stand behind it.")
  aboutImageUrl          String    @default("")
  aboutValue1Title       String    @default("Honest")
  aboutValue1Text        String    @default("No spin and no slogans for the sake of it. Every design starts with something we actually believe.")
  aboutValue2Title       String    @default("Simple")
  aboutValue2Text        String    @default("Black, white and grey. Clean typography. Pieces that let the message do the talking.")
  aboutValue3Title       String    @default("Made to order")
  aboutValue3Text        String    @default("Everything is printed on demand when you order it, so nothing is wasted on stock nobody wants.")
  updatedAt              DateTime  @updatedAt
}

// Products chosen for the homepage, in display order. Keyed by Shopify handle.
model FeaturedProduct {
  id        Int      @id @default(autoincrement())
  handle    String   @unique
  position  Int
  createdAt DateTime @default(now())
}

// The story shown in the "MORE INFO" section of a product page.
model ProductStory {
  handle    String   @id
  story     String   @default("")
  imageUrl  String   @default("")
  updatedAt DateTime @updatedAt
}

// Images uploaded through the admin panel (files live in UPLOAD_DIR).
model Media {
  id           Int      @id @default(autoincrement())
  filename     String   @unique
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
}

// Shop customers (accounts are optional: guests can always check out).
model Customer {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  name         String     @default("")
  passwordHash String
  createdAt    DateTime   @default(now())
  favorites    Favorite[]
}

// Products a signed-in customer saved. Guests keep favorites in a cookie instead.
model Favorite {
  id         Int      @id @default(autoincrement())
  customerId Int
  handle     String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, handle])
}
